{
  "name": "dci-score-predictor",
  "version": "0.0.0",
  "description": "Type-safe DCI drum corps score prediction — the v10.5 identity-agnostic ensemble model, self-contained, runs anywhere JS runs.",
  "license": "MIT",
  "author": "Patrick Glenn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/dci-score-predictor.git"
  },
  "homepage": "https://github.com/doeixd/dci-score-predictor#readme",
  "bugs": {
    "url": "https://github.com/doeixd/dci-score-predictor/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./simple": {
      "import": {
        "types": "./dist/simple.d.ts",
        "default": "./dist/simple.js"
      },
      "require": {
        "types": "./dist/simple.d.cts",
        "default": "./dist/simple.cjs"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/effect.d.ts",
        "default": "./dist/effect.js"
      },
      "require": {
        "types": "./dist/effect.d.cts",
        "default": "./dist/effect.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && TSUP_TARGET=index tsup && TSUP_TARGET=simple tsup && TSUP_TARGET=effect tsup && TSUP_TARGET=browser tsup",
    "smoke": "bash test/smoke/consumer-smoke.sh",
    "attw": "attw --pack . --profile node16 --ignore-rules no-resolution",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dci",
    "drum-corps",
    "prediction",
    "effect",
    "tensorflow",
    "marching-arts"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0"
  },
  "peerDependencies": {
    "effect": "^4.0.0-beta.99"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^26.1.1",
    "effect": "^4.0.0-beta.99",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "5.9",
    "vitest": "^4.1.10"
  }
}
